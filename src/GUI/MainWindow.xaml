<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        xmlns:oxy="http://oxyplot.org/wpf" x:Class="GUI.MainWindow"
        mc:Ignorable="d"
        Title="Math Interpreter" Height="450" Width="800">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Exit" x:Name="MenuExit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View Help" Command="{Binding HelpWindowShow}"/>
                <MenuItem Header="About" Command="{Binding AboutWindowShow}"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Row="0" Grid.Column="0" MaxLength="48" Text="{Binding InputExpression, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Command="{Binding InputEnter}" Key="Enter"></KeyBinding>
                    </TextBox.InputBindings>
                </TextBox>
                
                <Grid Grid.Column="1" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Margin="10" Grid.Column="0" Command="{Binding InputEnter}">
                        <TextBlock>Enter</TextBlock>
                    </Button>
                    <Button Margin="10" Grid.Column="1" Command="{Binding PlotEnter}">
                        <TextBlock>Plot</TextBlock>
                    </Button>
                </Grid>
            </Grid>
            
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="AlertTextBlock" Grid.Row="0" Grid.Column="0" TextAlignment="Center" Text="{Binding StatusMessage}" FontSize="32"></TextBlock>
                
                <oxy:PlotView Grid.Row="0" Grid.Column="1" Model="{Binding MyModel }" />
                
            </Grid>
            
        </Grid>
    </DockPanel>
</Window>
