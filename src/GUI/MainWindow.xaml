<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        xmlns:oxy="http://oxyplot.org/wpf" x:Class="GUI.MainWindow"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Math Interpreter" Height="600" Width="1200" Background="#A6CAF5">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Exit" x:Name="MenuExit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View Help" Command="{Binding HelpWindowShow}"/>
                <MenuItem Header="About" Command="{Binding AboutWindowShow}"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                        
                    <ComboBox 
                        x:Name="TargetLanguage"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding Compile.SelectedLanguage}"
                        Margin="15 20" 
                        Grid.Column="0"/>
                    <Button Margin="20" Grid.Column="1" Command="{Binding }">
                        <TextBlock>Run</TextBlock>
                    </Button>
                    <Button Margin="20" Grid.Column="2" Command="{Binding Compile.CompileEnter}">
                        <TextBlock>Compile</TextBlock>
                    </Button>
                </Grid>
                
                <avalonEdit:TextEditor
                    x:Name="CompilerOutputObject"
                    FontFamily="Consolas"
                    FontSize="14"
                    IsReadOnly="True"
                    SyntaxHighlighting="C++"
                    local:AvalonEditBinding.BoundText="{Binding CompilerOutput}"
                    Grid.Row="1"/>
                
                <avalonEdit:TextEditor
                    x:Name="TerminalOutputObject"
                    FontFamily="Consolas"
                    FontSize="14"
                    IsReadOnly="True"
                    SyntaxHighlighting="PowerShell"
                    local:AvalonEditBinding.BoundText="{Binding TerminalOutput}"
                    Grid.Row="2"/>

            </Grid>
            
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="8*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" MaxLength="200" Margin="5" Text="{Binding InputExpression, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True">
                        <TextBox.InputBindings>
                            <KeyBinding Command="{Binding Repl.InputEnter}" Gesture="CTRL+ENTER"></KeyBinding>
                        </TextBox.InputBindings>
                    </TextBox>
                    
                    <Grid Grid.Column="1" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Margin="15" Grid.Column="1" Command="{Binding Repl.InputEnter}">
                            <TextBlock>Enter</TextBlock>
                        </Button>
                        <Button Margin="15" Grid.Column="2" Command="{Binding Plot.PlotEnter}">
                            <TextBlock>Plot</TextBlock>
                        </Button>
                    </Grid>
                </Grid>
                
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="0" >
                            <TextBox x:Name="AlertTextBlock" 
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="5"/>
                        </ScrollViewer>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{ Binding Repl.SymbolTable }" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Variable" Binding="{Binding SymbolTableKey}" Width="5*"></DataGridTextColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding SymbolTableValue}" Width="5*"></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Scale:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <CheckBox IsChecked="{ Binding Plot.ScaleEnabled }"></CheckBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Marker:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <CheckBox IsChecked="{ Binding Plot.MarkerEnabled }"></CheckBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="xMin:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding Plot.XMin}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="xMax:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding Plot.XMax}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Step:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding Plot.Step}" />
                            </StackPanel>
                        </Grid>
                        
                        <oxy:PlotView Grid.Row="1" Model="{Binding Plot.Model }" Margin="5" />
                    </Grid>
                    
                </Grid>
            </Grid>
        </Grid>
        
    </DockPanel>
</Window>
