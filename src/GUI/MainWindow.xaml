<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        xmlns:oxy="http://oxyplot.org/wpf" x:Class="GUI.MainWindow"
        mc:Ignorable="d"
        Title="Math Interpreter" Height="551" Width="980" Background="#A6CAF5">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Exit" x:Name="MenuExit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View Help" Command="{Binding HelpWindowShow}"/>
                <MenuItem Header="About" Command="{Binding AboutWindowShow}"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="8*"/>
                </Grid.RowDefinitions>
                
                <DataGrid Grid.Row="2" ItemsSource="{ Binding SymbolTable }" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variable" Binding="{Binding SymbolTableKey}" Width="5*"></DataGridTextColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding SymbolTableValue}" Width="5*"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="8*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Row="0" Grid.Column="0" MaxLength="48" Margin="5" Text="{Binding InputExpression, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Command="{Binding InputEnter}" Key="Enter"></KeyBinding>
                        </TextBox.InputBindings>
                    </TextBox>
                    
                    <Grid Grid.Column="1" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Margin="10" Grid.Column="0" Command="{Binding InputEnter}">
                            <TextBlock>Enter</TextBlock>
                        </Button>
                        <Button Margin="10" Grid.Column="1" Command="{Binding PlotEnter}">
                            <TextBlock>Plot</TextBlock>
                        </Button>
                    </Grid>
                </Grid>
                
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="0" Grid.Column="0" >
                        <TextBox x:Name="AlertTextBlock" 
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Text="{Binding StatusMessage}"
                                 Margin="5"/>
                    </ScrollViewer>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Marker:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <CheckBox IsChecked="{ Binding MarkerEnabled }"></CheckBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="xMin:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding XMinInput}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="xMax:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding XMaxInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Step:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="60" Text="{Binding StepInput}" />
                            </StackPanel>
                        </Grid>
                        
                        <oxy:PlotView Grid.Row="1" Model="{Binding MyModel }" Margin="5"/>
                    </Grid>
                    
                </Grid>
            </Grid>
        </Grid>
        
    </DockPanel>
</Window>
